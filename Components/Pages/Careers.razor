                "Minimum of 2 year service desk experience and 1 year supervisory experience is required."
            }
        },

        // SLIDE 7
        new SolutionSlide
        {
            Title = "Technical Support Specialist",
            ListItems = new List<string>
            {
                "We are hiring technical support staff to join our End-User Support Team.",
                "As a technical support specialist, you shall provide hardware and software support for incidents and requests concerning the personal computer.",
                "No experience is needed."
            }
        }
    };

    private void NextSlide()
    {
        if (_currentSlide < MaxSlideIndex)
        {
            _currentSlide++;
        }
    }

    private void PreviousSlide()
    {
        if (_currentSlide > 0)
        {
            _currentSlide--;
        }
    }

    private void GoToSlide(int index)
    {
        if (index >= 0 && index <= MaxSlideIndex)
        {
            _currentSlide = index;
        }
    }

    // Model for each carousel slide.    
    private sealed class SolutionSlide
    {
        public string Icon { get; set; } = "";
        public string Title { get; set; } = "";
        public string ListHeading { get; set; } = "";
        public List<string> ListItems { get; set; } = new();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
      if (firstRender)
      {
        _visibleSlides = await JS.InvokeAsync<int>(
            "clientsCarousel.getVisibleSlides");

        StateHasChanged();
      }
    }
}