@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg h2-navbar">
    <div class="container nav-wrap">

        <!-- Company logo -->
        <a class="navbar-brand" href="/" aria-label="H2 Software Home">
            <img src="images/h2-new-logo.png"
                 alt="H2 Software"
                 class="h2-logo" />
        </a>

        <!-- Mobile menu button -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#h2Navigation"
                aria-controls="h2Navigation"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navigation links -->
        <div class="collapse navbar-collapse" id="h2Navigation">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                @* <li class="nav-item">
                    <NavLink class="nav-link"
                             href="/"
                             Match="NavLinkMatch.All">
                        Home
                    </NavLink>
                </li> *@

                <li class="nav-item">
                    <NavLink class="nav-link" href="/#services">
                        Services
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="/partners">
                        Partners
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="/clients">
                        Clients
                    </NavLink>
                </li>
                
                <li class="nav-item">
                    <NavLink class="nav-link" href="/careers">
                        Careers
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="/about-us">
                        About Us
                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link" href="@ContactUrl">
                        Contact Us
                    </NavLink>
                </li>
            </ul>
        </div>
    </div>
</nav>

@code {
    private string ContactUrl
    {
        get
        {
            var currentPath = new Uri(Navigation.Uri).AbsolutePath;

            // If you're on the home page, use /#contact
            if (currentPath == "/")
                return "/#contact";

            // Otherwise, use the current page path
            return $"{currentPath.TrimEnd('/')}#contact";
        }
    }
}