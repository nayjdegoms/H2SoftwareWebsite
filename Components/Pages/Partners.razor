@page "/partners"
@using H2SoftwareWebsite.Components.Layout

<PageTitle>Our Partners | H2 Software</PageTitle>

<div class="partners-page">

    <!-- Hero section -->
    <section class="partners-hero">
        <div class="partners-overlay">
            <div class="container">
                <div class="partners-hero-content">
                    <span class="partners-eyebrow">
                        OUR TECHNOLOGY ALLIANCES
                    </span>

                    <h1>Our Partners</h1>

                    <p>
                        We partner with trusted technology providers to bring proven 
                        technologies and reliable IT solutions to businesses across 
                        the Philippines.
                    </p>

                    <div class="partners-hero-line"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Introduction -->
    <section class="partners-intro">
        <div class="container">
            <div class="partners-intro-content">
                <span class="partners-section-label">
                    BUILDING BETTER SOLUTIONS TOGETHER
                </span>

                <h2>Technology Partnerships That Create Value</h2>

                <p>
                    Our technology alliances strengthen our ability to support businesses 
                    with specialized tools and expertise in IT service management, software 
                    development, and software testing. By combining our capabilities with 
                    those of our partners, we help organizations find solutions that meet 
                    their technical and operational needs.
                </p>
            </div>
        </div>
    </section>

    <!-- Partner cards -->
    <section class="partners-list-section">
        <div class="container">

            <div class="partners-grid">

                <!-- SapphireIMS -->
                <article class="partner-card">
                    <div class="partner-logo-area">
                        <img src="images/sapphire-logo-transparent.png"
                              alt="SapphireIMS logo"
                              class="partner-logo-image" />
                    </div>

                    <div class="partner-card-content">
                        <span class="partner-category">
                            IT SERVICE MANAGEMENT
                        </span>

                        <h2>SapphireIMS</h2>

                        <p>
                            SapphireIMS is an Indian software company
                            specializing in Service Desk and IT Asset
                            Management software.
                        </p>

                        <p>
                            Its solutions support IT service operations
                            and help organizations manage their IT assets
                            and service requests.
                        </p>

                        <a class="partner-link"
                           href="https://www.sapphireims.com/"
                           target="_blank"
                           rel="noopener noreferrer">
                            Visit SapphireIMS
                            <span aria-hidden="true"><i class="bi bi-arrow-up-right"></i></span>
                        </a>
                    </div>
                </article>

                <!-- Inflectra -->
                <article class="partner-card">
                    <div class="partner-logo-area">
                        <img src="images/inflectra-logo-transparent.png"
                              alt="Inflectra logo"
                              class="partner-logo-image" />
                    </div>

                    <div class="partner-card-content">
                        <span class="partner-category">
                            SOFTWARE QUALITY & TESTING
                        </span>

                        <h2>Inflectra</h2>

                        <p>
                            Inflectra develops software tools for
                            developers, testers, and project teams.
                        </p>

                        <p>
                            Its product portfolio includes tools that
                            support software testing, test management,
                            and project planning.
                        </p>

                        <a class="partner-link"
                           href="https://www.inflectra.com/"
                           target="_blank"
                           rel="noopener noreferrer">
                            Visit Inflectra
                            <span aria-hidden="true"><i class="bi bi-arrow-up-right"></i></span>
                        </a>
                    </div>
                </article>

            </div>
        </div>
    </section>

    <!-- Closing section -->
    <section class="partners-closing">
        <div class="container">
            <div class="partners-closing-content">
                <span class="partners-section-label">
                    OUR COMMITMENT
                </span>

                <h2>Better Technology. Stronger Partnerships.</h2>

                <p>
                    We value partnerships that help us deliver dependable
                    technology services and meaningful business solutions.
                </p>
            </div>
        </div>
    </section>

</div>

<section id="contact" class="contact-section">
  <ContactUs />
</section>

<!-- FOOTER -->
<Footer />