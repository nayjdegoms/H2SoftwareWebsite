@page "/about-us"
@using H2SoftwareWebsite.Components.Layout

<PageTitle>About Us | H2 Software</PageTitle>

<div class="about-page">

    <!-- Hero -->
    <section class="about-hero">
        <div class="about-overlay">
            <div class="container">
                <div class="about-hero-content">
                    <span class="about-eyebrow">GET TO KNOW US</span>

                    <h1>About H2 Software</h1>

                    <p>
                        A Filipino technology company providing Philippine-made software 
                        solutions and IT services that help businesses improve operations, 
                        enhance productivity, and achieve their goals.
                    </p>

                    <div class="about-hero-line"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Company introduction -->
    <section class="about-intro-section">
        <div class="container">
            <div class="about-intro-grid">

                <div class="about-image-wrapper">
                    <img src="images/about-us.jpg"
                         alt="H2 Software company"
                         class="about-company-image" />

                    <div class="about-image-accent"></div>
                </div>

                <div class="about-intro-content">
                    <span class="about-section-label">WHO WE ARE</span>

                    <h2>
                        Technology Solutions Tailored to
                        <span>Philippine Businesses</span>
                    </h2>

                    <p>
                        H2 Software Consulting Services, Inc. is a Filipino
                        IT company formed in 2011 to provide world-class
                        IT services and software solutions suited to
                        Philippine business settings.
                    </p>

                    <p>
                        The company has earned the trust of top corporations in the 
                        country for a wide range of IT services including payroll software, 
                        IT help desk, software development and software testing.
                    </p>

                    <p>
                        It now employs more than 250 highly skilled IT professionals.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!-- Company goal -->
    <section class="about-goal-section">
        <div class="container">
            <div class="about-goal-card">

                <div class="about-goal-icon">
                    <span aria-hidden="true"><i class="bi bi-bullseye"></i></span>
                </div>

                <span class="about-section-label">OUR GOAL</span>

                <h2>Empowering Businesses Through Technology</h2>

                <p>
                    To give Filipino companies the option to purchase
                    world-class Philippine-made IT services and
                    software solutions.
                </p>

            </div>
        </div>
    </section>
</div>

<section id="contact" class="contact-section">
  <ContactUs />
</section>

<!-- FOOTER -->
<Footer />